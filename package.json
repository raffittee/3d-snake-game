{
  "name": "snake-hunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "First-person 3D reverse Snake: you are the food.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "host": "tsx server/host.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.19",
    "@colyseus/schema": "^5.0.41",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@fontsource-variable/inter": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "cloudflared": "^0.7.3",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
